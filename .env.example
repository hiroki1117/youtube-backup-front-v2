# youtube-backup-front-v2 の環境変数（キー名のみ。値はコミットしない）
# Vite は VITE_* プレフィックスの変数のみをクライアントへ公開する。
# これらは公開前提の構成値（機密ではない）。真の機密はフロントに置かない。

# youtube-backup REST API のベース URL（例: https://api.example.com/prod）
VITE_API_BASE_URL=

# AWS Cognito User Pool 設定
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=
